{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generated schema for Root",
  "type": "object",
  "properties": {
    "_func": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_ref": {
      "type": "string"
    },
    "fiduciary_id": {
      "type": "string"
    },
    "page": {
      "type": "number"
    },
    "limit": {
      "type": "number"
    }
  },
  "required": [
    "_func"
  ],
  "anyOf": [
    { "required": ["user_id"] },
    { "required": ["user_ref"] }
  ]
}
